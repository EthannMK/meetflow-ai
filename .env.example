PORT=8080

# Optional AI API Keys (Can also be configured in the web UI Settings tab or skipped using Claude Pro Web Bridge)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional Google Calendar OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/calendar/google/callback

# Optional Microsoft Entra (Teams / Outlook Calendar) OAuth 2.0 Credentials
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:8080/api/calendar/microsoft/callback
